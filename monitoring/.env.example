# Required by the existing local Grafana service.
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-password

# Future WP Engine log collection configuration.
# These are placeholders only; the current local Compose stack does not
# consume them until a remote collection method is selected.
WPE_LOG_SOURCE_ENABLED=false
WPE_HEADLESS_API_BASE_URL=https://api.wpengineapi.com
WPE_HEADLESS_API_TOKEN=replace-with-a-wpengine-api-token
WPE_HEADLESS_APP_ID=replace-with-headless-app-id
WPE_HEADLESS_ENVIRONMENT_ID=replace-with-headless-environment-id
WPE_LOG_POLL_INTERVAL_SECONDS=30

# Optional SSH/file-source values for a future remote WordPress collector.
WPE_SSH_HOST=brounhallwpdev.ssh.wpengine.net
WPE_SSH_USER=brounhallwpdev
WPE_SSH_PRIVATE_KEY_PATH=replace-with-a-local-private-key-path
WPE_WORDPRESS_LOG_PATH=/nas/content/live/brounhallwpdev/_wpeprivate/brounhall-logs/wordpress.jsonl
